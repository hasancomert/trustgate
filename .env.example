# Copy to .env and fill in. Never commit .env.

# OpenAI-compatible LLM endpoint (default provider: Featherless)
LLM_BASE_URL=https://api.featherless.ai/v1
LLM_MODEL=Qwen/Qwen2.5-14B-Instruct
# Leave empty to run the LLM layer in mock mode (no network calls).
LLM_API_KEY=
# auto (live if LLM_API_KEY is set) | live | mock
LLM_MODE=auto
LLM_TIMEOUT_SECONDS=25

# Optional: alternative config file
# TRUSTGATE_CONFIG=config/settings.toml
